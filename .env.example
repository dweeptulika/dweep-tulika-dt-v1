# Supabase project values
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Content database provider (keep supabase until Neon data is migrated and verified)
CONTENT_DATABASE_PROVIDER=supabase
# Server-only Neon pooled connection string; never use NEXT_PUBLIC_ prefix
DATABASE_URL=

# Cloudflare R2 runtime uploads and media migration (server-only; never expose these to NEXT_PUBLIC_ variables)
NEON_MIGRATION_DATABASE_URL=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=
